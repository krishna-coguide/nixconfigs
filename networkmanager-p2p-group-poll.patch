         if (nm_streq(signal_name, "DeviceFound")) {
             if (g_variant_is_of_type(parameters, G_VARIANT_TYPE("(o)"))) {
@@ -3312,6 +3506,7 @@ _signal_handle(NMSupplicantInterface *self,
